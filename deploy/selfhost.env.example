# Generate a private deploy/selfhost.env with scripts/xobject configure.
# Use a published immutable image digest after a release exists.
XOBJECT_IMAGE=xobject:local-acceptance
BASE_URL=https://xobject.example
XOBJECT_HOST=xobject.example
TLS_EMAIL=admin@example.com
POSTGRES_PASSWORD=replace_with_an_independent_random_hex_password
RUNTIME_DATABASE_PASSWORD=replace_with_an_independent_random_hex_password
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Keep the dynamic pool and fixed proxy disjoint inside this subnet.
# Change all three together if the subnet overlaps an existing local network.
BACKEND_SUBNET=172.30.61.0/24
BACKEND_IP_RANGE=172.30.61.128/25
PROXY_ADDRESS=172.30.61.2

# Optional generic browser identity; use neutral for privacy in browser tabs.
APP_NAME=xObject
APP_DESCRIPTION="Connected data, contacts and projects in one workspace."
BROWSER_TITLE_MODE=context
