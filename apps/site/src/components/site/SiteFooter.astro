---
import { ArrowUp, CodeXml } from "@lucide/astro";
import SocialIcon from "./SocialIcon.astro";
import { socialLinks } from "../../config/social";
import { navigation, resources } from "../../config/navigation";
import { ui, type Language } from "../../config/content";
const { lang = "en" } = Astro.props as { lang?: Language };
const t = ui[lang],
  primaryNavigation = navigation(lang),
  projectResources = resources(lang);
---

<footer class="site-footer">
  <div class="site-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a
          class="parent-brand"
          href="https://itextreme.de/"
          aria-label="ITextreme – Solutions & Services"
        >
          <img
            class="logo-light"
            src="/brand/itextreme-logo.svg"
            width="1267"
            height="370"
            alt="ITextreme – Solutions & Services"
            loading="lazy"
          />
          <img
            class="logo-dark"
            src="/brand/itextreme-logo-inverted.svg"
            width="1267"
            height="370"
            alt="ITextreme – Solutions & Services"
            loading="lazy"
          />
        </a>
        <p>{t.description}</p>
        <ul class="footer-social" aria-label={t.social}>
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-label={`${link.label} – ${t.newTab}`}
                title={link.label}
                target="_blank"
                rel="noreferrer"
              >
                <SocialIcon name={link.label} />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <nav
        class="footer-columns"
        aria-label={lang === "de" ? "Footer-Navigation" : "Footer navigation"}
      >
        <div>
          <h2>xObject</h2>
          <ul data-section-navigation>
            {primaryNavigation.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>{t.project}</h2>
          <ul>
            {projectResources.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>{t.legal}</h2>
          <ul>
            <li>
              <a href="https://itextreme.de/datenschutzerklaerung" lang="de">
                {t.privacy}
              </a>
            </li>
            <li>
              <a href="https://itextreme.de/impressum" lang="de">
                {t.imprint}
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-bottom">
      <div>
        <p class="footer-credit">
          <CodeXml aria-hidden="true" />
          <span>{t.credit}</span>
          <a href="https://juergen-schadek.de">Jürgen Schadek</a>
          <span>· {t.built}</span>
        </p>
        <p class="footer-copyright">
          © {new Date().getUTCFullYear()} ITextreme. {t.rights}
        </p>
      </div>
      <a href="#seitenanfang">
        {t.top} <ArrowUp aria-hidden="true" stroke-width={1.5} />
      </a>
    </div>
  </div>
</footer>
