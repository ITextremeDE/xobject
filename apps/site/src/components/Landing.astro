---
import SiteLayout from "../layouts/SiteLayout.astro";
import Screenshot from "./Screenshot.astro";
import ScreenshotLightbox from "./ScreenshotLightbox.astro";
import { ProjectActions } from "./site/project-actions";
import { content, type Language } from "../config/content";
import { repositoryURL } from "../config/navigation";
import {
  UsersRound,
  FolderKanban,
  Boxes,
  ArrowUpRight,
  ShieldCheck,
  LogsIcon,
  PanelsTopLeft,
} from "@lucide/astro";
const { lang = "en" } = Astro.props as { lang?: Language };
const t = content[lang],
  icons = [UsersRound, FolderKanban, Boxes],
  controlIcons = [ShieldCheck, LogsIcon, PanelsTopLeft];
---

<SiteLayout
  title={`xObject by ITextreme – ${t.title}`}
  description={t.description}
  lang={lang}
  alternate
>
  <main id="inhalt" tabindex="-1">
    <section class="hero-band" id="overview" aria-labelledby="hero-heading">
      <div class="hero site-container">
        <div>
          <p class="eyebrow">{t.eyebrow}</p>
          <h1 id="hero-heading">
            {t.headline[0]}
            <br />
            <span>{t.headline[1]}</span>
          </h1>
          <p class="lead">{t.intro}</p>
          <ProjectActions repository={repositoryURL} lang={lang} />
          <p class="documentation-note">{t.enDocs}</p>
        </div>
        <Screenshot view="project" lang={lang} eager />
      </div>
    </section>
    <section
      class="product-section site-container"
      aria-labelledby="story-heading"
    >
      <div class="section-intro">
        <p class="eyebrow">
          {lang === "de"
            ? "Kontakt → Projekt → Vorgang → Aufgabe"
            : "Contact → Project → Case → Task"}
        </p>
        <h2 id="story-heading">{t.story}</h2>
        <p class="lead">{t.storyText}</p>
      </div>
      <ol class="workflow-steps">
        {t.steps.map(([title, text], i) => (
          <li>
            <span class="step-number" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <Screenshot view="list" lang={lang} />
    </section>
    <section
      class="product-section surface-band"
      id="features"
      aria-labelledby="features-heading"
    >
      <div class="site-container">
        <div class="section-intro">
          <h2 id="features-heading">{t.features}</h2>
          <p class="lead">{t.featuresText}</p>
        </div>
        <div class="feature-columns">
          {t.areas.map(([title, text], i) => {
            const Icon = icons[i];
            return (
              <article>
                <Icon
                  aria-hidden="true"
                  class="feature-icon"
                  stroke-width={1.5}
                />
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            );
          })}
        </div>
        <div class="screenshot-pair">
          <Screenshot view="contact" lang={lang} />
          <Screenshot view="custom" lang={lang} />
        </div>
      </div>
    </section>
    <section
      class="product-section site-container"
      id="control"
      aria-labelledby="control-heading"
    >
      <div class="feature-story">
        <div>
          <h2 id="control-heading">{t.control}</h2>
          <p class="lead">{t.controlText}</p>
          <div class="benefit-list">
            {t.controlItems.map(([title, text], i) => {
              const Icon = controlIcons[i];
              return (
                <article>
                  <Icon aria-hidden="true" stroke-width={1.5} />
                  <div>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
        <Screenshot view="journal" lang={lang} />
      </div>
    </section>
    <section
      class="product-section surface-band"
      aria-labelledby="automation-heading"
    >
      <div class="site-container automation-grid">
        <div>
          <p class="eyebrow">Web · API · MCP</p>
          <h2 id="automation-heading">{t.automation}</h2>
          <p class="lead">{t.automationText}</p>
          <a class="text-link" href="https://docs.xobject.org/api/">
            {t.api}
            <ArrowUpRight aria-hidden="true" />
          </a>
        </div>
        <figure class="agent-example">
          <figcaption>
            {lang === "de"
              ? "Ein Auftrag an Deinen KI-Client"
              : "A request to your AI client"}
          </figcaption>
          <blockquote>“{t.prompt}”</blockquote>
          <p>
            {lang === "de"
              ? "Mit Deinen Rechten. Nach denselben Regeln."
              : "Your permissions. The same rules."}
          </p>
        </figure>
      </div>
    </section>
    <section
      class="product-section site-container"
      id="start"
      aria-labelledby="start-heading"
    >
      <div class="feature-story">
        <div>
          <h2 id="start-heading">{t.own}</h2>
          <p class="lead">{t.ownText}</p>
          <ProjectActions repository={repositoryURL} lang={lang} />
          <a class="text-link" href={`${repositoryURL}/releases`}>
            {t.release}
            <ArrowUpRight aria-hidden="true" />
          </a>
          <p class="documentation-note">{t.enDocs}</p>
        </div>
        <ol class="install-steps">
          {t.ownSteps.map((step, i) => (
            <li>
              <span class="step-number" aria-hidden="true">
                0{i + 1}
              </span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="product-section surface-band" aria-labelledby="faq-heading">
      <div class="site-container faq-layout">
        <h2 id="faq-heading">{t.faq}</h2>
        <div>
          {t.questions.map(([question, answer]) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <p class="screenshot-disclosure site-container">{t.screenshots}</p>
  </main>
  <ScreenshotLightbox lang={lang} />
</SiteLayout>
