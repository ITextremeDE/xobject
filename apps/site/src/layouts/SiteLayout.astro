---
import "@fontsource-variable/inter";
import "@fontsource-variable/orbitron";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ui, type Language } from "../config/content";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  lang?: Language;
  alternate?: boolean;
}
const { title, description, lang = "en", alternate = false } = Astro.props;
const canonical = new URL(
  Astro.url.pathname === "/" ? "/en/" : Astro.url.pathname,
  Astro.site,
);
const t = ui[lang];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "xObject by ITextreme",
  url: Astro.site?.href,
  inLanguage: lang,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#f9fafb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#030712"
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      property="og:image"
      content={new URL("/social-preview.png", Astro.site)}
    />
    <meta
      property="og:image:alt"
      content="xObject — connected business data by ITextreme"
    />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    {alternate && (
      <>
        <link
          rel="alternate"
          hreflang="en"
          href={new URL("/en/", Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="de"
          href={new URL("/de/", Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL("/", Astro.site)}
        />
      </>
    )}
    <script is:inline src="/language.js"></script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/itextreme-it-logo.svg" type="image/svg+xml" />
    <script is:inline src="/theme-init.js"></script>
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body id="seitenanfang">
    <a class="skip-link" href="#inhalt">
      {t.skip}
    </a>
    <SiteHeader lang={lang} />
    <slot />
    <SiteFooter lang={lang} />

    <script src="../scripts/navigation.js"></script>
  </body>
</html>
