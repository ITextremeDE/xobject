  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/schema.sql src/oauth-journal.sql src/module-catalog.json dist/ && cp -R src/skills dist/skills",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/main.ts",
    "admin:create": "tsx src/cli.ts create-admin",
    "db:init": "tsx src/cli.ts initialize"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.18",
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
