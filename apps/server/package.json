    "@inquirer/prompts": "8.7.5",
    "@modelcontextprotocol/server": "2.4.0",
    "@xobject/contracts": "1.0.1",
    "better-auth": "1.7.18",
    "fastify": "5.12.8",
    "kysely": "0.29.8",
    "libphonenumber-js": "1.13.15",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
