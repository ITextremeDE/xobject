#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
ROOT=$(cd "$(dirname "$0")/.." && pwd)
ENV_FILE=${XOBJECT_ENV_FILE:-$ROOT/deploy/selfhost.env}
PROJECT=${XOBJECT_PROJECT_NAME:-xobject}
[[ $PROJECT =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo 'Invalid Compose project name.' >&2; exit 1; }
COMPOSE=(docker compose --project-name "$PROJECT" --env-file "$ENV_FILE" -f "$ROOT/deploy/compose.selfhost.yaml")
if [[ -n ${XOBJECT_COMPOSE_OVERRIDE:-} ]]; then COMPOSE+=(-f "$XOBJECT_COMPOSE_OVERRIDE"); fi
START_SERVICES=()
for service in ${XOBJECT_START_SERVICES:-app proxy}; do
  [[ $service == app || $service == proxy ]] || { echo 'Invalid start service.' >&2; exit 1; }
  START_SERVICES+=("$service")
done
compose() { "${COMPOSE[@]}" "$@"; }
setting() { local key=$1 line; while IFS= read -r line; do case "$line" in "$key="*) printf '%s' "${line#*=}"; return;; esac; done < "$ENV_FILE"; return 1; }
checksum() { if command -v sha256sum >/dev/null; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }
checksum_check() { if command -v sha256sum >/dev/null; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi; }
image_id() { docker image inspect "$(setting XOBJECT_IMAGE)" --format '{{.Id}}'; }
operator() { compose run --rm -T operator "$@"; }
backup() {
  local directory=$1 was_running=0 running
  [[ ! -e $directory ]] || { echo 'Backup target already exists; choose a new directory.' >&2; return 1; }
  mkdir -p "$directory"
  running=$(compose ps --status running --services)
  if [[ $'\n'"$running"$'\n' == *$'\napp\n'* ]]; then was_running=1; fi
  compose stop app
  local app_container current_image image_ref
  app_container=$(compose ps -a -q app)
  if [[ -n $app_container ]]; then
    current_image=$(docker inspect "$app_container" --format '{{.Image}}')
    image_ref=$(docker inspect "$app_container" --format '{{.Config.Image}}')
  else current_image=$(image_id); image_ref=$(setting XOBJECT_IMAGE); fi
  [[ $image_ref =~ @sha256:[a-f0-9]{64}$ ]] || image_ref=$current_image
  printf '%s\n' "$current_image" > "$directory/image-id.txt"
  while IFS= read -r line; do case "$line" in XOBJECT_IMAGE=*) printf 'XOBJECT_IMAGE=%s\n' "$image_ref";; *) printf '%s\n' "$line";; esac; done < "$ENV_FILE" > "$directory/install.env"
  compose exec -T db pg_dump --format=custom --no-owner --no-acl -U xobject -d xobject > "$directory/database.dump.partial"
  compose exec -T db pg_restore --list < "$directory/database.dump.partial" > /dev/null
  mv "$directory/database.dump.partial" "$directory/database.dump"
  compose exec -T db psql -X -v ON_ERROR_STOP=1 -At -U xobject -d xobject -c 'SELECT definition_hash FROM sys_schema_version WHERE singleton' > "$directory/schema.txt"
  compose config --images > "$directory/images.txt"
  date -u '+%Y-%m-%dT%H:%M:%SZ' > "$directory/created-at.txt"
  (cd "$directory"; checksum database.dump install.env image-id.txt schema.txt images.txt created-at.txt > SHA256SUMS)
  if [[ $was_running == 1 ]]; then compose start --wait app; fi
  printf 'Verified backup created: %s\n' "$directory"
}
case ${1:-help} in
  configure)
    [[ $# == 4 ]] || { echo 'Usage: scripts/xobject configure HTTPS_ORIGIN IMAGE TLS_EMAIL' >&2; exit 1; }
    [[ ! -e $ENV_FILE ]] || { echo 'Configuration exists; it was not overwritten.' >&2; exit 1; }
    [[ $2 =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?$ || $2 =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]+)?$ ]] || { echo 'Use an HTTPS origin, or HTTP loopback for local acceptance.' >&2; exit 1; }
    [[ $3 =~ ^[a-zA-Z0-9][a-zA-Z0-9./:@_-]+$ && $4 =~ ^[a-zA-Z0-9._+%-]+@[a-zA-Z0-9.-]+$ ]] || { echo 'Invalid image reference or TLS contact email.' >&2; exit 1; }
    mkdir -p "$(dirname "$ENV_FILE")"
    cat > "$ENV_FILE" <<CONFIG
XOBJECT_IMAGE=$3
BASE_URL=$2
XOBJECT_HOST=${2#*://}
TLS_EMAIL=$4
POSTGRES_PASSWORD=$(openssl rand -hex 32)
RUNTIME_DATABASE_PASSWORD=$(openssl rand -hex 32)
BETTER_AUTH_SECRET=$(openssl rand -hex 32)
BACKEND_SUBNET=172.30.61.0/24
BACKEND_IP_RANGE=172.30.61.128/25
PROXY_ADDRESS=172.30.61.2
CONFIG
    chmod 600 "$ENV_FILE"
    echo 'Private installation configuration created.'
    ;;
  setup)
    compose up -d --wait db
    operator initialize
    if [[ -n ${ADMIN_NAME:-}${ADMIN_EMAIL:-}${ADMIN_PASSWORD:-} ]]; then
      compose run --rm -T -e ADMIN_NAME -e ADMIN_EMAIL -e ADMIN_PASSWORD operator setup
    else compose run --rm operator setup; fi
    ;;
  start) compose up -d --wait "${START_SERVICES[@]}" ;;
  stop) compose stop app proxy ;;
  verify) operator verify-installation ;;
  backup)
    [[ $# == 2 ]] || { echo 'Usage: scripts/xobject backup NEW_PRIVATE_DIRECTORY' >&2; exit 1; }
    backup "$2"
    ;;
  restore)
    [[ $# == 3 && $3 == --confirm-restore ]] || { echo 'Usage: scripts/xobject restore BACKUP_DIRECTORY --confirm-restore' >&2; exit 1; }
    bundle=$(cd "$2" && pwd)
    (cd "$bundle"; checksum_check)
    # Read recovery configuration as data; never source it as executable shell code.
    previous_env=$ENV_FILE
    ENV_FILE=$bundle/install.env
    expected=$(cat "$bundle/image-id.txt")
    recovered_ref=$(setting XOBJECT_IMAGE)
    docker image inspect "$recovered_ref" >/dev/null 2>&1 || docker pull "$recovered_ref"
    [[ $recovered_ref =~ @sha256:[a-f0-9]{64}$ || $(image_id) == "$expected" ]] || { echo 'Load the matching backup image before restoration.' >&2; exit 1; }
    ENV_FILE=$previous_env
    compose exec -T db pg_restore --list < "$bundle/database.dump" > /dev/null
    compose stop app proxy
    existing=$(compose exec -T db psql -X -v ON_ERROR_STOP=1 -At -U xobject -d xobject -c "SELECT count(*) FROM pg_tables WHERE schemaname='public'")
    if [[ $existing != 0 ]]; then backup "${bundle}-before-restore-$(date -u +%Y%m%dT%H%M%SZ)"; fi
    cp "$ENV_FILE" "${ENV_FILE}.before-restore-$(date -u +%Y%m%dT%H%M%SZ)"
    cp "$bundle/install.env" "$ENV_FILE"
    # A restore remains stopped until target verification succeeds and the operator starts it.
    compose exec -T db psql -X -v ON_ERROR_STOP=1 -U xobject -d postgres -c 'DROP DATABASE xobject WITH (FORCE)' -c 'CREATE DATABASE xobject OWNER xobject'
    compose exec -T db pg_restore --no-owner --no-acl --exit-on-error --single-transaction -U xobject -d xobject < "$bundle/database.dump"
    operator provision-runtime
    operator verify-installation
    echo 'Restore verified. Application remains stopped. Run scripts/xobject start when ready.'
    ;;
  upgrade)
    [[ $# == 3 ]] || { echo 'Usage: scripts/xobject upgrade IMMUTABLE_IMAGE NEW_BACKUP_DIRECTORY' >&2; exit 1; }
    [[ $2 =~ @sha256:[a-f0-9]{64}$ || $2 =~ ^sha256:[a-f0-9]{64}$ ]] || { echo 'Use an immutable image digest for upgrades.' >&2; exit 1; }
    docker image inspect "$2" >/dev/null 2>&1 || docker pull "$2"
    compose stop app proxy
    backup "$3"
    replacement=$(mktemp "${ENV_FILE}.upgrade.XXXXXX")
    while IFS= read -r line; do case "$line" in XOBJECT_IMAGE=*) printf 'XOBJECT_IMAGE=%s\n' "$2";; *) printf '%s\n' "$line";; esac; done < "$ENV_FILE" > "$replacement"
    mv "$replacement" "$ENV_FILE"
    # No released predecessor exists yet. Unknown source schemas fail closed.
    operator upgrade --backup-verified --writers-stopped
    compose up -d --wait "${START_SERVICES[@]}"
    echo 'Upgrade verified and application started.'
    ;;
  *)
    cat <<'HELP'
xObject installation operator
  configure HTTPS_ORIGIN IMAGE TLS_EMAIL
  setup
  start | stop | verify
  backup NEW_PRIVATE_DIRECTORY
  restore BACKUP_DIRECTORY --confirm-restore
  upgrade IMMUTABLE_IMAGE NEW_BACKUP_DIRECTORY

XOBJECT_ENV_FILE, XOBJECT_PROJECT_NAME and XOBJECT_COMPOSE_OVERRIDE select an
explicit installation. Failed restore/upgrade operations leave the app stopped.
HELP
    ;;
esac
