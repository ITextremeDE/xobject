# Development only. Use independent passwords; never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-database-password
OPERATOR_DATABASE_URL=postgres://xobject:replace-with-a-random-database-password@127.0.0.1:5410/xobject_dev
DATABASE_URL=postgres://xobject_app:replace-with-an-independent-runtime-password@127.0.0.1:5410/xobject_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BASE_URL=http://127.0.0.1:4100

# Optional generic browser identity; neutral hides workspace/record titles in tabs.
APP_NAME=xObject
APP_DESCRIPTION="Connected data, contacts and projects in one workspace."
BROWSER_TITLE_MODE=context
